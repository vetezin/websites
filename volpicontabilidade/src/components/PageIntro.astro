---
import { withBase } from '../data/paths.js';
const { label, title, description } = Astro.props;
---
<section class="page-intro">
  <div class="container"><nav class="breadcrumbs" aria-label="Você está aqui"><a href={withBase('/')}>Início</a><span aria-hidden="true">/</span><span aria-current="page">{label}</span></nav><span class="eyebrow">{label}</span><h1>{title}</h1><p>{description}</p></div>
</section>
