---
import { withBase } from '../data/paths.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import '../styles/global.css';
const { title, description = 'Assessoria contábil, fiscal, trabalhista e empresarial em Presidente Prudente. Desde 2007, a Volpi apoia sua empresa com clareza e atendimento próximo.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0097d7" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Volpi Contabilidade" />
    <meta property="og:title" content={`${title} | Volpi Contabilidade`} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={withBase('/fonts/be-vietnam-pro-400.woff2')} as="font" type="font/woff2" crossorigin />
    <title>{title} | Volpi Contabilidade</title>
  </head>
  <body><Header /><main id="conteudo" tabindex="-1"><slot /></main><Footer /><Motion /></body>
</html>
