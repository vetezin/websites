---
import { withBase } from '../data/paths.js';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactBanner from '../components/ContactBanner.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="A Volpi — nossa história">
  <PageIntro label="A Volpi" title="Uma história de experiência. Um olhar para o seu futuro." description="Desde 2007, uma parceria que coloca a informação contábil a serviço do negócio." />
  <section class="section"><div class="container story-grid"><div class="story-copy"><span class="eyebrow">Nossa origem</span><h2>Conhecimento que<br />se transforma em parceria.</h2><p>A Volpi Contabilidade foi fundada em 2007 por Sérgio Voltareli do Monte, após 25 anos de atuação como gerente contábil em um grupo empresarial.</p><p>Sua trajetória passou por construção viária, incorporação imobiliária, agronegócio, energia, concessão rodoviária e shopping centers. Essa experiência deu origem a uma empresa com visão ampla sobre os desafios da gestão.</p><p>Desde o início, a proposta é oferecer assessoria contábil e fiscal, terceirização da contabilidade, abertura e regularização de empresas de pequeno, médio e grande porte.</p><p>Entendemos a contabilidade como uma ferramenta para apoiar empresários, investidores e demais interessados nos resultados, além de atender às obrigações fiscais.</p></div><figure class="story-image"><img src={withBase('/images/meeting.webp')} alt="Imagem ilustrativa de uma reunião empresarial, preservada do site original" width="1100" height="733" /><figcaption><strong>Desde 2007</strong><span>Experiência contábil. Visão empresarial.</span></figcaption></figure></div></section>
  <section class="section principles-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">O que orienta nosso trabalho</span><h2>Princípios que fazem<br />parte de cada atendimento.</h2></div><p>Uma relação construída com ética, respeito e compromisso com o desenvolvimento das empresas.</p></div><div class="principles-grid"><article><Icon name="chart" size={30} /><h3>Nossa missão</h3><p>Potencializar os negócios dos clientes por meio de serviços contábeis de qualidade, com transparência, suporte e rapidez.</p></article><article><Icon name="building" size={30} /><h3>Nossa visão</h3><p>Ser reconhecida pela qualidade do trabalho, buscando melhoria contínua e apoio presente para gerar valor às empresas parceiras.</p></article><article><Icon name="people" size={30} /><h3>Nossos valores</h3><p>Ética, respeito e compromisso com os clientes e com os princípios da contabilidade. Atendimento humano e qualidade em cada ação.</p></article></div></div></section>
  <section class="section"><div class="container narrow-content"><span class="eyebrow">Como trabalhamos</span><h2>Proximidade para entender.<br />Conhecimento para orientar.</h2><p>Nosso atendimento inclui suporte técnico aos departamentos da empresa, visitas periódicas para acompanhamento e relatórios com observações e sugestões. Também respondemos a consultas por telefone e pessoalmente.</p><a href={withBase('/servicos/')} class="text-link">Explore nossas soluções <Icon size={18} /></a></div></section>
  <ContactBanner />
</Layout>
