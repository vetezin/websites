---
import { withBase } from '../data/paths.js';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { company, services } from '../data/company.js';
---
<Layout title="Fale com a Volpi">
  <PageIntro label="Contato" title="Vamos conversar sobre os seus próximos passos." description="Seja para abrir sua empresa, organizar a rotina ou buscar orientação, conte o que você precisa. Estamos aqui para entender." />
  <section class="section contact-section"><div class="container contact-grid">
    <div class="contact-information"><span class="eyebrow">Atendimento próximo</span><h2>Uma conversa pode<br />abrir novos caminhos.</h2><p>Escolha o canal mais confortável para você ou prepare sua mensagem pelo formulário.</p><a class="contact-channel" href={company.whatsappHref} target="_blank" rel="noopener noreferrer"><span class="channel-icon"><Icon name="whatsapp" size={25} /></span><span><small>WhatsApp</small><strong>{company.whatsapp}</strong></span><Icon name="external" size={19} /></a><a class="contact-channel" href={company.phoneHref}><span class="channel-icon"><Icon name="phone" size={24} /></span><span><small>Telefone</small><strong>{company.phone}</strong></span><Icon size={19} /></a><a class="contact-channel" href={`mailto:${company.email}`}><span class="channel-icon"><Icon name="mail" size={24} /></span><span><small>E-mail</small><strong>{company.email}</strong></span><Icon size={19} /></a><div class="contact-address"><Icon name="location" size={24} /><div><h3>Visite a Volpi</h3><p>{company.street}<br />{company.neighborhood}<br />{company.city} / {company.state} · CEP {company.postalCode}</p><a class="text-link" href={company.maps} target="_blank" rel="noopener noreferrer">Como chegar <Icon name="external" size={17} /></a></div></div></div>
    <div class="contact-form-panel"><h2>Conte um pouco sobre você.</h2><p>Preencha os campos para preparar uma mensagem. Você confere e confirma o envio no WhatsApp.</p><noscript><p class="form-error">Para usar o formulário, habilite o JavaScript. Você também pode nos contatar pelos links de WhatsApp, telefone ou e-mail ao lado.</p></noscript><form id="contact-form">
      <div class="form-grid"><div class="form-field"><label for="name">Seu nome <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Como podemos chamar você?" /></div><div class="form-field"><label for="business">Empresa <span>(opcional)</span></label><input id="business" name="business" autocomplete="organization" maxlength="150" placeholder="Nome da sua empresa" /></div><div class="form-field"><label for="email">E-mail <span>(opcional)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" placeholder="voce@empresa.com.br" /></div><div class="form-field"><label for="phone">Telefone <span>(opcional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="20" placeholder="(18) 99999-9999" /></div></div>
      <div class="form-field"><label for="service">Sobre o que vamos conversar? <span aria-hidden="true">*</span></label><select id="service" name="service" required><option value="geral">Informações gerais / orçamento</option>{services.map(service => <option value={service.id}>{service.title}</option>)}</select></div>
      <div class="form-field"><label for="message">Sua mensagem <span aria-hidden="true">*</span></label><textarea id="message" name="message" required minlength="10" maxlength="1500" rows="4" placeholder="Conte o momento da sua empresa e como podemos ajudar."></textarea><span class="field-hint">Campos com * são obrigatórios.</span></div>
      <p class="form-privacy">Os dados serão incluídos na mensagem que você enviar pelo WhatsApp. <a href={withBase('/privacidade/')}>Saiba mais sobre privacidade.</a></p>
      <p id="form-errors" class="form-error" role="alert" tabindex="-1" hidden></p>
      <button type="submit" class="button button-blue">Preparar mensagem <Icon size={19} /></button>
    </form><div id="message-result" class="message-result" hidden><h3 tabindex="-1" id="result-title">Sua mensagem está pronta.</h3><p>Confira abaixo. Ela só será enviada quando você confirmar no WhatsApp.</p><p id="message-preview" class="message-preview"></p><a id="message-link" class="button button-blue" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20} /> Abrir WhatsApp com mensagem <Icon name="external" size={17} /></a></div></div>
  </div></section>
</Layout>
<script>
  import { prepareWhatsApp } from '../data/contact.js';
  const form = document.querySelector('#contact-form');
  const result = document.querySelector('#message-result');
  const preview = document.querySelector('#message-preview');
  const link = document.querySelector('#message-link');
  const errors = document.querySelector('#form-errors');
  const select = document.querySelector('#service');
  if (select instanceof HTMLSelectElement) {
    const requested = new URLSearchParams(window.location.search).get('servico');
    if (Array.from(select.options).some(option => option.value === requested)) select.value = requested || 'geral';
  }
  if (form instanceof HTMLFormElement && result instanceof HTMLElement && preview instanceof HTMLElement && link instanceof HTMLAnchorElement && errors instanceof HTMLElement) {
    form.addEventListener('input', () => {
      result.hidden = true;
      errors.hidden = true;
      link.removeAttribute('href');
      preview.textContent = '';
    });
    form.addEventListener('submit', event => {
      event.preventDefault();
      const prepared = prepareWhatsApp(Object.fromEntries(new FormData(form)));
      if (prepared.errors.length) {
        result.hidden = true;
        errors.textContent = prepared.errors.join(' ');
        errors.hidden = false;
        errors.focus();
        return;
      }
      errors.hidden = true;
      preview.textContent = prepared.message || '';
      link.href = prepared.href || '';
      result.hidden = false;
      document.querySelector('#result-title')?.scrollIntoView({ block: 'nearest' });
      if (document.querySelector('#result-title') instanceof HTMLElement) document.querySelector('#result-title')?.focus({ preventScroll: true });
    });
  }
</script>
