---
import { withBase } from '../data/paths.js';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactBanner from '../components/ContactBanner.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/company.js';
---
<Layout title="Soluções contábeis e empresariais">
  <PageIntro label="Soluções" title="O apoio certo para cada momento da sua empresa." description="Assessoria contábil, fiscal, trabalhista e empresarial. Conhecimento integrado para acompanhar sua rotina e seus próximos passos." />
  <section class="section"><div class="container service-page-grid"><aside class="service-aside"><span class="eyebrow">Encontre sua solução</span><nav aria-label="Áreas de atuação">{services.map(service => <a href={`#${service.id}`}>{service.title}<Icon size={17} /></a>)}</nav><div class="aside-help"><h2>Por onde começar?</h2><p>Conte o que sua empresa precisa. Vamos conversar sobre as soluções adequadas.</p><a class="text-link" href={withBase('/contato/')}>Fale com a Volpi <Icon size={18} /></a></div></aside><div class="service-details">{services.map(service => <article id={service.id} class="service-detail"><div class="detail-heading"><span class="solution-icon"><Icon name={service.icon} size={30} /></span><h2>{service.title}</h2></div><p>{service.description}</p><ul>{service.items.map(item => <li><Icon name="check" size={18} /><span>{item}</span></li>)}</ul><a class="text-link" href={withBase(`/contato/?servico=${service.id}`)}>Conversar sobre esta solução <Icon size={18} /></a></article>)}</div></div></section>
  <ContactBanner />
</Layout>
