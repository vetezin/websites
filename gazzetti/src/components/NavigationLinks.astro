---
import { navigation } from '../data/site.js';
const { active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{navigation.map(item => <a class:list={{ 'header-contact': item.path === 'contato/' }} href={base + item.path} aria-current={active === item.path ? 'page' : undefined}>{item.label}</a>)}
