---
import Icon from './Icon.astro';
const { section, path = 'contato/' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="closing section"><div class="container closing-inner"><div><h2>{section.headings[0].text}</h2>{section.paragraphs.map(text => <p>{text}</p>)}</div><a class="button button-secondary" href={base + path}>{section.cta}<Icon size={20} /></a></div></section>
