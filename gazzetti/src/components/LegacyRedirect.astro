---
import Layout from '../layouts/Layout.astro';
const { path } = Astro.props;
const destination = import.meta.env.BASE_URL + path;
---
<Layout title="Página movida | Gazzetti Advogados Associados" description="Este endereço foi atualizado." redirectPath={path}><section class="container page-hero"><h1>Este endereço foi atualizado.</h1><p><a class="text-link" href={destination}>Acessar a página atual</a></p></section></Layout>
