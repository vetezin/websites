---
import Layout from '../layouts/Layout.astro';
import Editorial from '../components/Editorial.astro';
import ContactBand from '../components/ContactBand.astro';
import Icon from '../components/Icon.astro';
import { content, areaIds, site, ui } from '../data/site.js';
const page = content.home;
const [hero, intro, areas, philosophy, closing] = page.sections;
const base = import.meta.env.BASE_URL;
---
<Layout title={page.title} description={page.description}>
 <section class="container home-hero"><div class="hero-copy"><h1>{hero.headings[0].text}</h1>{hero.paragraphs.map(text => <p>{text}</p>)}<a class="button" href={base + 'areas-de-atuacao/'}>{hero.cta}<Icon size={20} /></a></div><figure class="hero-photo"><div class="photo-frame"><img src={base + site.officePhoto} srcset={base + 'images/escritorio-640.webp 640w, ' + base + 'images/escritorio-960.webp 960w, ' + base + site.officePhoto + ' 1392w'} sizes="(min-width: 1024px) 500px, (min-width: 768px) 80vw, calc(100vw - 48px)" alt="Porta de madeira e vidro, fachada e placa Gazzetti Advogados Associados" width="1392" height="894" fetchpriority="high" /></div><figcaption>{ui.photo}</figcaption></figure></section>
 <section class="section section-lined"><div class="container editorial"><Editorial section={intro}><a class="text-link" href={base + 'o-escritorio/'}>{intro.cta}<Icon size={20} /></a></Editorial></div></section>
 <section class="section areas-overview"><div class="container"><h2 class="section-heading">{areas.headings[0].text}</h2><div class="area-grid">{areaIds.map((id, i) => <article class="area-card"><h3>{areas.headings[i + 1].text}</h3><p>{areas.paragraphs[i]}</p><a class="text-link" href={base + 'areas-de-atuacao/#' + id} aria-label={'Saiba mais sobre ' + areas.headings[i + 1].text}>Saiba mais<Icon size={20} /></a></article>)}</div><a class="text-link overview-link" href={base + 'areas-de-atuacao/'}>Explore nossas áreas de atuação<Icon size={20} /></a></div></section>
 <section class="section philosophy"><div class="container editorial"><Editorial section={philosophy} /></div></section>
 <ContactBand section={closing} />
</Layout>
