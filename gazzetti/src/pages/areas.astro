---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactBand from '../components/ContactBand.astro';
import { areas } from '../data/site.js';
const base = import.meta.env.BASE_URL;
---
<Layout title="Áreas de atuação" active="areas/" description="Estruturação de negócios, negociação empresarial e advocacia contenciosa. Conheça os escopos de atuação da Gazzetti.">
  <section class="page-intro container"><p class="eyebrow">Áreas de atuação</p><div class="intro-columns"><h1>Visão do todo.<br /><em>Atenção a cada frente.</em></h1><p class="lead">O momento da empresa define a necessidade. O trabalho jurídico conecta as alternativas.</p></div></section>
  <nav class="area-index container" aria-label="Nesta página">{areas.map(area => <a href={`#${area.id}`}><Icon name={area.icon} size={24} />{area.short}<Icon name="arrow" size={18} /></a>)}</nav>
  <div class="container area-details">{areas.map(area => <section class="area-detail" id={area.id}><div class="area-detail-title" data-reveal><Icon name={area.icon} size={48} /><h2>{area.title}</h2><p class="lead">{area.intro}</p><a class="text-link" href={`${base}contato/?area=${area.id}`}>Converse com o escritório <Icon name="arrow" size={20} /></a></div><div class="area-detail-copy" data-reveal><p>{area.description}</p><h3>Escopo de atuação</h3><ul class="service-list">{area.services.map(service => <li><Icon name="check" size={18} />{service}</li>)}</ul><details><summary>{area.question}<Icon name="plus" size={20} /></summary><p>{area.answer}</p></details></div></section>)}</div>
  <ContactBand />
</Layout>
