---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { resources } from '../data/site.js';
const categories = ['Todos', ...new Set(resources.map(resource => resource.category))];
---
<Layout title="Links úteis" active="uteis/" description="Acesse portais oficiais de tribunais, serviços tributários e informações empresariais em um só lugar.">
  <section class="page-intro container"><p class="eyebrow">Links úteis</p><div class="intro-columns"><h1>Informação confiável.<br /><em>Acesso mais simples.</em></h1><p class="lead">Uma seleção de portais oficiais para facilitar a consulta a informações e serviços.</p></div></section>
  <section class="container resources-section"><div class="resource-tools"><div class="search-control"><label for="resource-search">Buscar portal ou serviço</label><div><Icon name="search" size={20} /><input id="resource-search" type="search" placeholder="Ex.: tribunal, Receita Federal…" autocomplete="off" /></div></div><fieldset class="resource-filters"><legend>Filtrar por categoria</legend>{categories.map((category, i) => <button type="button" data-category={category} aria-pressed={i === 0 ? 'true' : 'false'}>{category}</button>)}</fieldset></div><p class="resource-count" role="status" aria-live="polite"><span data-resource-count>{resources.length}</span> portais encontrados</p><div class="resource-grid">{resources.map(resource => <a class="resource" href={resource.url} target="_blank" rel="noopener noreferrer" data-resource data-category={resource.category} data-search={`${resource.title} ${resource.acronym} ${resource.description}`}><div class="resource-top"><span>{resource.acronym}</span><Icon name="external" size={20} /></div><h2>{resource.title}</h2><p>{resource.description}</p><span class="resource-category">{resource.category} · site externo</span></a>)}</div><div class="empty-results" hidden><h2>Nenhum portal encontrado.</h2><p>Tente outra palavra ou selecione todas as categorias.</p><button type="button" class="text-link" data-reset-search>Limpar busca <Icon name="arrow" size={18} /></button></div><p class="small-note resource-disclaimer">Você será direcionado aos sites das instituições. Os serviços e seus conteúdos são de responsabilidade dos respectivos órgãos.</p></section>
</Layout>
