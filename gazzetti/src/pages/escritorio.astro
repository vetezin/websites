---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Signature from '../components/Signature.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site.js';
const base = import.meta.env.BASE_URL;
---
<Layout title="O escritório" active="escritorio/" description="Conheça a proposta de atuação empresarial da Gazzetti: estruturação, negociação e contencioso, com atenção ao contexto de cada negócio.">
  <section class="page-intro container"><p class="eyebrow">O escritório</p><div class="intro-columns"><h1>O Direito com<br /><em>visão de negócio.</em></h1><p class="lead">Uma atuação jurídica conectada às decisões, aos desafios e às possibilidades da atividade empresarial.</p></div></section>
  <section class="office-editorial container"><figure class="office-editorial-image"><img src={`${base}${site.officePhoto.image}`} alt="Fachada do escritório Gazzetti, com a porta de entrada e a placa de identificação" width="1392" height="894" /><figcaption>Fotografia do escritório preservada do site original</figcaption></figure><div class="office-editorial-copy" data-reveal><p class="eyebrow">Gazzetti Advogados Associados</p><h2>Compreender o cenário.<br />Construir caminhos.</h2><p>A Gazzetti atua na advocacia e na consultoria empresarial, com foco em estruturação de negócios, negociações e acompanhamento de conflitos.</p><p>A atuação consultiva e contenciosa se conecta às necessidades de organização, continuidade e desenvolvimento da atividade empresarial. Cada demanda exige análise própria e definição cuidadosa do escopo de trabalho.</p><a class="text-link" href={`${base}areas/`}>Explore nossas áreas <Icon name="arrow" size={20} /></a></div></section>
  <section class="section container"><div class="section-heading" data-reveal><div><p class="eyebrow">Nossa perspectiva</p><h2>O que orienta<br />uma boa atuação.</h2></div><p>Uma proposta de trabalho fundamentada em análise, comunicação e responsabilidade.</p></div><div class="principles-grid"><article data-reveal><span class="principle-mark"></span><h3>Contexto antes<br />da estratégia.</h3><p>Compreender a empresa, os documentos e os interesses envolvidos para delimitar a questão jurídica.</p></article><article data-reveal><span class="principle-mark"></span><h3>Clareza em<br />cada decisão.</h3><p>Traduzir os caminhos possíveis, suas implicações e os pontos que precisam ser avaliados.</p></article><article data-reveal><span class="principle-mark"></span><h3>Proximidade ao<br />longo do trabalho.</h3><p>Organizar o acompanhamento e a comunicação de acordo com o escopo contratado.</p></article></div></section>
  <section class="office-statement"><div class="container"><Signature /><p>Estruturação, negociação e contencioso.<br /><em>Uma perspectiva empresarial em comum.</em></p><a class="text-link" href={`${base}equipe/`}>Pessoas que fazem parte dessa visão <Icon name="arrow" size={20} /></a></div></section>
  <ContactBand />
</Layout>
