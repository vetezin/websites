---
import Layout from '../layouts/Layout.astro';
import TeamGrid from '../components/TeamGrid.astro';
import ContactBand from '../components/ContactBand.astro';
---
<Layout title="Equipe" active="equipe/" description="Explore a apresentação demonstrativa da equipe: perfis fictícios organizados por suas frentes de atuação empresarial.">
  <section class="page-intro container"><p class="eyebrow">Equipe</p><div class="intro-columns"><h1>Visões que se somam.<br /><em>Relações que importam.</em></h1><p class="lead">O trabalho jurídico é feito por pessoas. Conheça a proposta de apresentação dos profissionais e de suas especialidades.</p></div></section>
  <section class="container team-page"><div class="demo-banner"><span class="demo-banner-mark" aria-hidden="true">i</span><div><strong>Equipe ilustrativa</strong><p>Nomes, fotografias geradas por IA, cargos e biografias são fictícios. Este conteúdo demonstra o novo design e será substituído pela equipe real.</p></div></div><TeamGrid /><div class="team-note"><span>Especialidades complementares.</span><p>Perfis completos, informações profissionais e fotografias autorizadas farão parte da versão final.</p></div></section>
  <ContactBand />
</Layout>
