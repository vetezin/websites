---
import '../styles/global.css';
import NavigationLinks from '../components/NavigationLinks.astro';
import { navigation, site, ui } from '../data/site.js';
const { title = site.name, description = '', active = '', redirectPath }  = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(redirectPath ? base + redirectPath : Astro.url.pathname, Astro.site);
const ogImage = new URL(base + site.officePhoto, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
<head>
 <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
 <title>{title}</title><meta name="description" content={description} />
 <meta name="robots" content="noindex, follow" /><meta name="theme-color" content="#041C38" />
 <link rel="canonical" href={canonical} />
 {redirectPath && <meta http-equiv="refresh" content={'0;url=' + base + redirectPath} />}
 <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" /><meta property="og:site_name" content={site.name} />
 <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:alt" content="Porta e fachada da Gazzetti no site original" />
 <meta name="twitter:card" content="summary_large_image" />
 <link rel="icon" type="image/png" href={base + 'images/logo.png'} />
 <link rel="stylesheet" href={base + 'fonts/fonts.css'} />
 <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: new URL(base, Astro.site).href })} />
</head>
<body>
 <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
 <header class="site-header"><div class="container header-inner">
  <a class="brand" href={base} aria-label="Gazzetti Advogados Associados — início"><img src={base + 'images/logo.png'} alt="Gazzetti Advogados Associados" width="223" height="74" /></a>
  <nav class="desktop-navigation" aria-label="Navegação principal"><NavigationLinks active={active} /></nav>
  <details class="mobile-navigation"><summary aria-controls="mobile-menu"><span class="menu-label">Menu</span><span class="menu-lines" aria-hidden="true"></span></summary><nav id="mobile-menu" aria-label="Navegação principal"><NavigationLinks active={active} /></nav></details>
 </div></header>
 <main id="conteudo" tabindex="-1"><slot /></main>
 <footer class="site-footer"><div class="container">
  <div class="footer-main"><a class="brand" href={base}><img src={base + 'images/logo.png'} alt="Gazzetti Advogados Associados — início" width="223" height="74" loading="lazy" /></a><nav aria-label="Navegação do rodapé"><a href={base}>Home</a>{navigation.map(item => <a href={base + item.path}>{item.label}</a>)}</nav></div>
  <div class="footer-bottom"><p>{ui.demo}</p><a href={base + 'politica-de-privacidade/'}>Política de Privacidade</a></div>
 </div></footer>
 <script>import '../scripts/interactions.js';</script>
</body>
</html>
